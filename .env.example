# ==========================================
# Global configs:
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================


# ==========================================
# Backend Configuration
# ==========================================
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# ==========================================

# ==========================================
# Backend Configuration (choose one)
# ==========================================

# === TODO por OpenRouter (una sola API key) ==============================
# Pon tu clave de OpenRouter en las DOS variables de abajo (mismo valor).

# --- CHAT: DeepSeek V4 Flash (soporte nativo de OpenRouter en LiteLLM) ---
CHAT_MODEL="openrouter/deepseek/deepseek-v4-flash"
OPENROUTER_API_KEY=""

# --- EMBEDDING: se enruta por OpenRouter (endpoint compatible OpenAI) ---
EMBEDDING_MODEL="litellm_proxy/openai/text-embedding-3-small"
LITELLM_PROXY_API_KEY=""
LITELLM_PROXY_API_BASE="https://openrouter.ai/api/v1"

# Si DeepSeek devuelve etiquetas <think> en las respuestas, descomenta:
# REASONING_THINK_RM=True

# ---------------------------------------------------------------
# Otros modelos de embedding disponibles en OpenRouter (cambia EMBEDDING_MODEL):
#   litellm_proxy/qwen/qwen3-embedding-8b     (~$0.01/M)
#   litellm_proxy/baai/bge-m3                 (~$0.01/M, multilingüe)
#   litellm_proxy/google/gemini-embedding-001 (~$0.15/M)
# ==========================================

# ==========================================
# Other Configuration 
# ==========================================
# CHAT_AZURE_API_BASE=<for_Azure_user>
# CHAT_AZURE_API_VERSION=<for_Azure_user>

# EMBEDDING_AZURE_API_BASE=<for_Azure_user>
# EMBEDDING_AZURE_API_VERSION=<for_Azure_user>

# Cache Setting (Optional):
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# FT_DOCKER_ENABLE_CACHE=True
# DS_DOCKER_ENABLE_CACHE=True

# ==========================================
# Config de escenarios
# ==========================================
# --- data_science (dataset local, NO Kaggle) ---
# La ruta se fija automáticamente con setup_wsl.sh (dotenv set), pero puedes
# dejarla aquí. Descomenta y ajusta si no usas el script:
# DS_LOCAL_DATA_PATH="/ruta/al/repo/git_ignore_folder/ds_data"
DS_SCEN="rdagent.scenarios.data_science.scen.DataScienceScen"
DS_CODER_ON_WHOLE_PIPELINE=True
DS_IF_USING_MLE_DATA=False
DS_SAMPLE_DATA_BY_LLM=False
#
# Para competiciones KAGGLE en su lugar, cambia a:
# DS_SCEN="rdagent.scenarios.data_science.scen.KaggleScen"
# DS_IF_USING_MLE_DATA=True
# DS_SAMPLE_DATA_BY_LLM=True
# (y configura ~/.config/kaggle/kaggle.json)
# ==========================================